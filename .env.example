# ═══════════════════════════════════════════════════════════════
# VARIABLES — Trezor Livraison (modèle)
# ═══════════════════════════════════════════════════════════════
# Copier vers .env (gitignored). Ne JAMAIS committer de vraies clés.
# Release : --dart-define (pas d'asset .env dans l'APK).
#
# flutter run \
#   --dart-define=API_BASE_URL=https://trezorbackend-production.up.railway.app \
#   --dart-define=GOOGLE_MAPS_API_KEY=votre_cle
#
# Android Maps SDK : aussi dans android/local.properties
#   GOOGLE_MAPS_API_KEY=votre_cle

API_BASE_URL=https://trezorbackend-production.up.railway.app
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOLOCATION_API_KEY=
